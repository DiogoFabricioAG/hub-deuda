/// Observaciones de validación (dbo.vObservacionCalidad). No se relaciona con vDeuda.
table vObservacionCalidad
	lineageTag: f1a7445d-4728-5140-8aa3-aa538054353a

	/// Observaciones registradas.
	measure Observaciones = COUNTROWS(vObservacionCalidad)
		formatString: #,0
		displayFolder: Métricas de carga
		lineageTag: ebe6d2d1-e362-5775-8bbc-3ab65f3d013f

	/// Observaciones no subsanadas (Subsanada = FALSE).
	measure ObservacionesPendientes = COALESCE(CALCULATE(COUNTROWS(vObservacionCalidad), vObservacionCalidad[Subsanada] = FALSE()), 0)
		formatString: #,0
		displayFolder: Métricas de carga
		lineageTag: d8a65db1-307c-5ff4-b10f-ea8653f7a25c

	column ObservacionId
		dataType: int64
		formatString: 0
		lineageTag: 609aceb3-70e7-56e5-9221-a37b543c5ee2
		summarizeBy: none
		sourceColumn: ObservacionId

	column LoteId
		dataType: string
		lineageTag: c2dc229e-3770-5471-8735-2950217bad5b
		summarizeBy: none
		sourceColumn: LoteId

	column AreaId
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: fcafbbf9-4fbc-5b48-a3da-564de5428a2b
		summarizeBy: none
		sourceColumn: AreaId

	column FilaExcel
		dataType: int64
		formatString: 0
		lineageTag: 22517a4f-26b0-52eb-968c-e17f9d126cd4
