		summarizeBy: none
		sourceColumn: Campo

	column Codigo
		dataType: string
		lineageTag: 0305930a-11a9-5cfb-a80d-59d023be76b0
		summarizeBy: none
		sourceColumn: Codigo

	column CreadoUtc
