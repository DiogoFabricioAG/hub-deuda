	/// Fecha (UTC) de CreadoUtc del lote.
	column FechaCreadoUtc
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 99d52d41-4cd0-5388-86a3-26f19aae5d72
		summarizeBy: none
		sourceColumn: FechaCreadoUtc

		annotation UnderlyingDateTimeDataType = Date

	partition vObservacionCalidad = m
		mode: import
		source =
				let
				    Origen = Sql.Database(ServidorSQL, BaseSQL),
				    Vista = Origen{[Schema = "dbo", Item = "vObservacionCalidad"]}[Data],
				    Columnas = Table.SelectColumns(Vista, {"ObservacionId", "LoteId", "AreaId", "FilaExcel", "Campo", "Codigo", "CreadoUtc", "Subsanada"}),
				    Tipos = Table.TransformColumnTypes(Columnas, {{"ObservacionId", Int64.Type}, {"LoteId", type text}, {"AreaId", Int64.Type}, {"FilaExcel", Int64.Type}, {"Campo", type text}, {"Codigo", type text}, {"CreadoUtc", type datetime}, {"Subsanada", type logical}}),
				    ConFecha = Table.AddColumn(Tipos, "FechaCreadoUtc", each DateTime.Date([CreadoUtc]), type date)
				in
				    ConFecha
