		sourceColumn: FilasConError

	/// Fecha (UTC) de CreadoUtc, para la evolución diaria.
	column FechaCreadoUtc
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: a41d7d49-4cc4-549f-bf12-474cbd7c02f7
		summarizeBy: none
		sourceColumn: FechaCreadoUtc

		annotation UnderlyingDateTimeDataType = Date

	partition vLoteCalidad = m
		mode: import
		source =
				let
				    Origen = Sql.Database(ServidorSQL, BaseSQL),
				    Vista = Origen{[Schema = "dbo", Item = "vLoteCalidad"]}[Data],
				    Columnas = Table.SelectColumns(Vista, {"LoteId", "AreaId", "Area", "Estado", "FilasLeidas", "CreadoUtc", "PublicadoUtc", "SegundosPublicacion", "Errores", "FilasConError"}),
				    Tipos = Table.TransformColumnTypes(Columnas, {{"LoteId", type text}, {"AreaId", Int64.Type}, {"Area", type text}, {"Estado", type text}, {"FilasLeidas", Int64.Type}, {"CreadoUtc", type datetime}, {"PublicadoUtc", type datetime}, {"SegundosPublicacion", Int64.Type}, {"Errores", Int64.Type}, {"FilasConError", Int64.Type}}),
				    ConFecha = Table.AddColumn(Tipos, "FechaCreadoUtc", each DateTime.Date([CreadoUtc]), type date)
				in
				    ConFecha
