/// Movimientos vigentes por área (dbo.vMovimientoDetalle).
table vMovimientoDetalle
	lineageTag: d6ca8284-0c5b-5c91-ac05-705f0d5a7686

	/// Movimientos vigentes (lotes publicados).
	measure CantidadMovimientos = COUNTROWS(vMovimientoDetalle)
		formatString: #,0
		displayFolder: Métricas de carga
		lineageTag: 914740d4-daf5-5343-ad02-ebff573df852

	/// Suma de montos de movimientos vigentes (sin signo).
	measure MontoMovimientos = SUM(vMovimientoDetalle[Monto])
