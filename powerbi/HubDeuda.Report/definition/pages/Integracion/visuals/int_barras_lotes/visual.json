                  "Expression": {
                    "SourceRef": {
                      "Entity": "vLoteCalidad"
                    }
                  },
                  "Property": "Lotes"
                }
              },
              "queryRef": "vLoteCalidad.Lotes",
              "nativeQueryRef": "Lotes"
